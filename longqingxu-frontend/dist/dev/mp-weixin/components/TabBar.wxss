.custom-tabbar.data-v-7d9a6b19 {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  padding: 16rpx 48rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-around;
  /* 高于 uni-h5 内置 tabbar，避免首帧叠层时压住自定义图标 */
  z-index: 10050;
}
.custom-tabbar .tab-item.data-v-7d9a6b19 {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.custom-tabbar .tab-item .tab-icon-slot.data-v-7d9a6b19 {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: filter 0.22s ease;
  margin-bottom: 8rpx;
}
.custom-tabbar .tab-item .tab-text.data-v-7d9a6b19 {
  font-size: 22rpx;
  color: #9CA3AF;
}
.custom-tabbar .tab-item.active .tab-icon-slot.data-v-7d9a6b19 {
  /* 与未选中保持同尺寸，避免四个里有一个偏大 */
  filter: drop-shadow(0 6rpx 14rpx rgba(139, 92, 246, 0.42));
}
.custom-tabbar .tab-item.active .tab-text.data-v-7d9a6b19 {
  color: #8B5CF6;
  font-weight: 600;
}