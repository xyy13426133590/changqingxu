/* 卡片容器：透视交给容器，子卡片只做 rotateY + translate3d（GPU 合成，避免 clip/blur 卡顿） */
.card-container {
  flex: 1;
  margin: 0 32rpx;
  position: relative;
  min-height: 680rpx;
  perspective: 1400px;
  transform-style: preserve-3d;
}
/*
 * cx-pass（X / 左滑）：当前卡向左侧 3D 翻出飞出；下一张从右侧轻旋入
 * cx-heart（星 / 右滑）：当前卡向右侧 3D 翻出飞出；下一张从左侧轻旋入
 * 仅过渡 transform + opacity，丝滑优先
 */
.cx-heart-leave-active,
.cx-heart-enter-active,
.cx-pass-leave-active,
.cx-pass-enter-active {
  will-change: transform, opacity;
}
.cx-heart-leave-active {
  transform-origin: 0 50%;
  transition: transform 0.44s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.36s ease-out;
}
.cx-heart-enter-active {
  transform-origin: 50% 50%;
  transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.42s ease-out;
}
.cx-heart-leave-from {
  opacity: 1;
  transform: translate3d(0, 0, 0) rotateY(0deg) rotateX(0deg) scale(1);
}
.cx-heart-leave-to {
  opacity: 0;
  transform: translate3d(118%, 0, -120px) rotateY(62deg) rotateX(6deg) scale(0.92);
}
.cx-heart-enter-from {
  opacity: 0;
  transform: translate3d(-32%, 0, -60px) rotateY(-22deg) scale(0.94);
}
.cx-heart-enter-to {
  opacity: 1;
  transform: translate3d(0, 0, 0) rotateY(0deg) rotateX(0deg) scale(1);
}
.cx-pass-leave-active {
  transform-origin: 100% 50%;
  transition: transform 0.44s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.36s ease-out;
}
.cx-pass-enter-active {
  transform-origin: 50% 50%;
  transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.42s ease-out;
}
.cx-pass-leave-from {
  opacity: 1;
  transform: translate3d(0, 0, 0) rotateY(0deg) rotateX(0deg) scale(1);
}
.cx-pass-leave-to {
  opacity: 0;
  transform: translate3d(-118%, 0, -120px) rotateY(-62deg) rotateX(6deg) scale(0.92);
}
.cx-pass-enter-from {
  opacity: 0;
  transform: translate3d(32%, 0, -60px) rotateY(22deg) scale(0.94);
}
.cx-pass-enter-to {
  opacity: 1;
  transform: translate3d(0, 0, 0) rotateY(0deg) rotateX(0deg) scale(1);
}
@media (prefers-reduced-motion: reduce) {
.cx-heart-enter-active,
  .cx-heart-leave-active,
  .cx-pass-enter-active,
  .cx-pass-leave-active {
    transition-duration: 0.14s !important;
}
.cx-heart-leave-active,
  .cx-heart-enter-active,
  .cx-pass-leave-active,
  .cx-pass-enter-active {
    will-change: auto;
}
}
