/* 全局基础样式：微信小程序 WXSS 不支持通配符 *，改用 page + 常用内置组件 */
page {
  -webkit-tap-highlight-color: transparent;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: #f8f4ff;
  background: linear-gradient(180deg, #322055 0%, #261845 50%, #1c1038 100%);
  min-height: 100vh;
}
page,
view,
text,
image,
button,
input,
textarea,
scroll-view,
swiper,
swiper-item,
navigator,
rich-text,
picker,
slider,
switch,
checkbox,
radio,
label,
form,
canvas,
video,
map,
cover-view,
cover-image {
  box-sizing: border-box;
}
/* 渐变背景 */
.gradient-bg {
  background: linear-gradient(180deg, #322055 0%, #261845 50%, #1c1038 100%);
  min-height: 100vh;
}
/* 模块卡片：实色表面 + 轻模糊（方案 B 层次台阶） */
.glass {
  background: #2a1a4a;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 200, 220, 0.2);
}
.glass-dark {
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 200, 220, 0.08);
}
/* 文字工具类 */
.font-logo {
  font-family: "Great Vibes", cursive, "Georgia", serif;
  font-style: normal;
}
.text-gradient {
  background: linear-gradient(135deg, #c084fc, #f472b6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
/* 按钮基础样式 */
.btn, .btn-secondary, .btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: transform 200ms, opacity 200ms;
}
.btn:active, .btn-secondary:active, .btn-primary:active {
  transform: scale(0.96);
  opacity: 0.9;
}
.btn-primary {
  background: linear-gradient(135deg, #c084fc, #f472b6);
  color: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(244, 114, 182, 0.22);
}
.btn-secondary {
  background: rgba(255, 200, 220, 0.12);
  border: 1rpx solid rgba(255, 200, 220, 0.2);
  color: #f8f4ff;
}
.btn-press:active {
  transform: scale(0.94);
  opacity: 0.92;
}
/* 徽章样式 */
.badge, .badge-vip, .badge-match {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.badge-match {
  background: linear-gradient(135deg, #c084fc, #f472b6);
  color: #ffffff;
}
.badge-vip {
  background: linear-gradient(135deg, #F59E0B, #F97316);
  color: #ffffff;
}
/* 标签样式（支持多枚换行、单枚内长文案换行） */
.tag, .tag-purple-light, .tag-amber, .tag-orange, .tag-green, .tag-purple, .tag-blue, .tag-yellow {
  display: inline-flex;
  align-items: flex-start;
  flex: 0 1 auto;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
  padding: 8rpx 16rpx;
  border-radius: 9999rpx;
  font-size: 24rpx;
  white-space: normal;
  word-break: break-word;
}
.tag-yellow {
  background: rgba(251, 191, 36, 0.18);
  color: #fcd34d;
}
.tag-blue {
  background: rgba(147, 197, 253, 0.15);
  color: #93c5fd;
}
.tag-purple {
  background: rgba(216, 180, 254, 0.15);
  color: #d8b4fe;
}
.tag-green {
  background: rgba(110, 231, 183, 0.15);
  color: #6ee7b7;
}
.tag-orange {
  background: rgba(253, 186, 116, 0.18);
  color: #fdba74;
}
.tag-amber {
  background: rgba(252, 211, 77, 0.18);
  color: #fde68a;
}
.tag-purple-light {
  background: rgba(249, 168, 212, 0.15);
  color: #f9a8d4;
}
/* 标签行：占满宽度并允许子项在窄屏下换行 */
.tags-row {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}
.tags-row > view {
  max-width: 100%;
  min-width: 0;
  flex: 0 1 auto;
  align-items: flex-start;
  white-space: normal;
  word-break: break-word;
}
.tags-row > view > text {
  white-space: normal;
  word-break: break-word;
  line-height: 1.4;
  max-width: 100%;
}
/* 滚动条隐藏 */
.no-scrollbar {
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.no-scrollbar::-webkit-scrollbar {
  display: none;
}
/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
/* 呼吸感动画 */
@keyframes breathe-scale {
0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(244, 114, 182, 0.2);
}
50% {
    transform: scale(1.03);
    box-shadow: 0 0 20rpx 4rpx rgba(244, 114, 182, 0.22);
}
}
@keyframes breathe-opacity {
0%, 100% {
    opacity: 1;
}
50% {
    opacity: 0.88;
}
}
@keyframes float-y {
0%, 100% {
    transform: translateY(0);
}
50% {
    transform: translateY(-4rpx);
}
}
@keyframes shimmer {
0% {
    background-position: 0% 50%;
}
100% {
    background-position: 100% 50%;
}
}
.anim-avatar {
  animation: breathe-scale 3.2s ease-in-out infinite;
}
.anim-card {
  animation: breathe-opacity 4s ease-in-out infinite;
}
.anim-float {
  animation: float-y 4.5s ease-in-out infinite;
}
/* 圆形水波纹头像 */
.avatar-ripple {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-ripple::before, .avatar-ripple::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 144rpx;
  height: 144rpx;
  margin-left: -72rpx;
  margin-top: -72rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(249, 168, 212, 0.5);
  box-shadow: 0 0 0 1rpx rgba(244, 114, 182, 0.3), 0 0 18rpx rgba(244, 114, 182, 0.18);
  pointer-events: none;
  animation: ripple 2.8s ease-out infinite;
}
.avatar-ripple::after {
  animation-delay: 1.4s;
  border-color: rgba(216, 180, 254, 0.45);
}
.avatar-ripple .avatar-img {
  position: relative;
  z-index: 1;
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 20rpx rgba(244, 114, 182, 0.18);
  animation: avatar-breathe 3.2s ease-in-out infinite;
}
.avatar-ripple .avatar-camera {
  position: absolute;
  z-index: 2;
  right: 8rpx;
  bottom: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #c084fc, #f472b6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(244, 114, 182, 0.22);
}
@keyframes ripple {
0% {
    transform: scale(0.92);
    opacity: 0.75;
}
100% {
    transform: scale(1.42);
    opacity: 0;
}
}
@keyframes avatar-breathe {
0%, 100% {
    transform: scale(1);
}
50% {
    transform: scale(1.02);
}
}
/* 聊天气泡 */
.chat-bubble-me {
  background: linear-gradient(135deg, #c084fc, #f472b6);
  color: #fff;
  border-radius: 24rpx 24rpx 8rpx 24rpx;
  padding: 16rpx 24rpx;
  max-width: 70%;
  word-break: break-word;
}
.chat-bubble-other {
  background: rgba(255, 200, 220, 0.1);
  border: 1rpx solid rgba(255, 200, 220, 0.18);
  color: #f8f4ff;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
  padding: 16rpx 24rpx;
  max-width: 70%;
  word-break: break-word;
}
/* 风险提示条 */
.risk-banner {
  background: rgba(251, 191, 36, 0.15);
  border: 1rpx solid rgba(251, 191, 36, 0.3);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.risk-banner .risk-icon {
  color: #B45309;
  font-size: 32rpx;
}
.risk-banner .risk-text {
  flex: 1;
  font-size: 24rpx;
  color: #92400E;
  line-height: 1.5;
}
/* 底部弹层 */
.bottom-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #2a1a4a;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 200, 220, 0.12);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 100;
}
.bottom-sheet::before {
  content: "";
  display: block;
  width: 72rpx;
  height: 6rpx;
  background: rgba(249, 168, 212, 0.3);
  border-radius: 3rpx;
  margin: 0 auto 32rpx;
}
/* VIP 卡片 */
.vip-card {
  background: linear-gradient(135deg, #FCD34D, #F97316, #EC4899);
  border-radius: 32rpx;
  padding: 40rpx;
  color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(249, 115, 22, 0.3);
}
/* 自定义 TabBar */
.custom-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #352560;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(255, 200, 220, 0.2);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.25);
  padding: 14rpx 0 calc(14rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-around;
  z-index: 100;
}
.custom-tabbar .tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.custom-tabbar .tab-item .tab-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}
.custom-tabbar .tab-item .tab-text {
  font-size: 20rpx;
  color: rgba(235, 228, 255, 0.78);
}
.custom-tabbar .tab-item.active .tab-text {
  color: #e879f9;
  font-weight: 700;
}
.custom-tabbar .tab-item:not(.active) {
  color: rgba(235, 228, 255, 0.78);
}
/* 页面容器 */
.page-container {
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}
/* 隐藏原生 TabBar 时的页面底部间距 */
.no-tabbar {
  padding-bottom: env(safe-area-inset-bottom);
}
/* ==================== 顶栏返回按钮（全局） ==================== */
/* flex 居中标题会铺满整行并挡住左侧返回区，导致小程序里点击无反应 */
.filter-header .back-btn,
.profile-header .back-btn,
.messages-header .back-btn,
.my-card-header .back-btn,
.vip-header .back-btn,
.chat-header .back-btn {
  position: relative;
  z-index: 30;
  flex-shrink: 0;
}
.filter-header .header-title,
.profile-header .title,
.messages-header .title,
.my-card-header .title,
.vip-header .title {
  pointer-events: none;
}
/* 仅禁用 back-btn 内文字抢点击；勿对 .auth-nav-back / .nav-back 全局禁用，否则 @tap 绑在文字上无效 */
.back-btn text {
  pointer-events: none;
}
.auth-nav .auth-nav-back-wrap,
.glass-row.nav .nav-back-wrap,
.user-detail-nav .nav-back-wrap,
.welcome-page .back-circle {
  position: relative;
  z-index: 30;
  flex-shrink: 0;
}
.auth-nav .auth-nav-title,
.glass-row.nav .nav-title,
.user-detail-nav .nav-title {
  pointer-events: none;
}
/* ==================== 筛选页专用样式 ==================== */
/* 筛选页头部 */
.filter-header {
  display: flex;
  align-items: center;
  padding: 0;
  padding-left: 32rpx;
  position: relative;
  z-index: 10;
}
.filter-header .back-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 200, 220, 0.1);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 200, 220, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.filter-header .back-btn text {
  font-size: 40rpx;
  color: rgba(255, 220, 240, 0.7);
  font-weight: 300;
}
.filter-header .header-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #f0e8ff;
  margin-right: 72rpx;
}
/* 筛选内容区 */
.filter-content {
  flex: 1;
  min-height: 0;
  padding: 0 32rpx;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}
/* 筛选模块卡片 */
.filter-section {
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
/* 模块标题 */
.filter-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #f0e8ff;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}
.filter-title .title-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}
/* 2×2 布局：列间距 20rpx、行间距 20rpx（不依赖 gap） */
.filter-grid-2 {
  display: flex;
  flex-wrap: wrap;
}
.filter-grid-2 > .filter-option {
  box-sizing: border-box;
  width: calc((100% - 20rpx) / 2);
  margin-bottom: 20rpx;
}
.filter-grid-2 > .filter-option:nth-child(2n) {
  margin-left: 20rpx;
}
/* 选项按钮 */
.filter-option {
  padding: 24rpx;
  background: #3d2d62;
  border: 1rpx solid rgba(255, 200, 220, 0.14);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}
.filter-option .option-title {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(255, 220, 240, 0.85);
}
.filter-option .option-title + .option-desc {
  margin-top: 8rpx;
}
.filter-option .option-desc {
  font-size: 22rpx;
  color: rgba(235, 225, 250, 0.75);
  text-align: center;
  line-height: 1.4;
}
.filter-option.active {
  background: #c084fc;
}
.filter-option.active .option-title,
.filter-option.active .option-desc {
  color: #fff;
}
/* 筛选提示文字 */
.filter-hint {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(255, 200, 220, 0.06);
  border-radius: 12rpx;
}
.filter-hint text {
  font-size: 22rpx;
  color: rgba(235, 225, 250, 0.75);
  line-height: 1.5;
}
/* 滑块标签 */
.slider-labels {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}
.slider-labels text {
  font-size: 26rpx;
  color: rgba(248, 242, 255, 0.92);
}
.slider-labels text.current {
  font-size: 30rpx;
  font-weight: 600;
  color: #c084fc;
}
/* 按钮组 */
.filter-buttons {
  display: flex;
}
.filter-buttons > .filter-btn + .filter-btn {
  margin-left: 16rpx;
}
.filter-btn {
  flex: 1;
  padding: 20rpx 0;
  background: #3d2d62;
  border: 1rpx solid rgba(255, 200, 220, 0.14);
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  color: rgba(255, 220, 240, 0.85);
  transition: all 0.2s ease;
}
.filter-btn.active {
  background: #c084fc;
  color: #fff;
}
/* 标签组 */
.filter-tags {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx 0 0 -8rpx;
}
.filter-tags > .filter-tag {
  margin: 8rpx 0 0 8rpx;
}
.filter-tag {
  padding: 16rpx 28rpx;
  background: #3d2d62;
  border: 1rpx solid rgba(255, 200, 220, 0.14);
  border-radius: 9999rpx;
  font-size: 26rpx;
  color: rgba(255, 220, 240, 0.85);
  transition: all 0.2s ease;
}
.filter-tag.active {
  background: #c084fc;
  color: #fff;
}
/* 应用筛选按钮区 */
.apply-btn-wrapper {
  padding: 32rpx 0;
}
.apply-btn {
  width: 100%;
  padding: 28rpx 0;
  background: linear-gradient(135deg, #c084fc, #f472b6);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(244, 114, 182, 0.35);
}
.apply-btn text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}
/* ==================== 消息模块专用样式 ==================== */
/* 消息页头部 */
.messages-header {
  display: flex;
  align-items: center;
  padding: 0;
  padding-left: 32rpx;
  position: relative;
  z-index: 10;
}
.messages-header .back-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 200, 220, 0.1);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 200, 220, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.messages-header .back-btn text {
  font-size: 40rpx;
  color: rgba(255, 220, 240, 0.7);
  font-weight: 300;
}
.messages-header .title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #f0e8ff;
  margin-right: 72rpx;
}
/* 会话列表 */
.conversation-list {
  flex: 1;
  min-height: 0;
  padding: 0 32rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}
.conversation-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 200, 220, 0.1);
  position: relative;
}
.conversation-item.top {
  background: rgba(244, 114, 182, 0.06);
}
.conversation-item .avatar-wrap {
  position: relative;
  margin-right: 24rpx;
}
.conversation-item .avatar-wrap .avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}
.conversation-item .avatar-wrap .unread-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 12rpx;
  background: #EF4444;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.4);
}
.conversation-item .content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.conversation-item .content .top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.conversation-item .content .top-row .nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #f0e8ff;
  max-width: 70%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.conversation-item .content .top-row .time {
  font-size: 24rpx;
  color: rgba(235, 225, 250, 0.75);
}
.conversation-item .content .last-message {
  font-size: 26rpx;
  color: rgba(248, 242, 255, 0.92);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 空状态 */
.empty-state {
  padding: 120rpx 48rpx;
  text-align: center;
}
.empty-state text {
  font-size: 28rpx;
  color: #9CA3AF;
}
/* 聊天页头部 */
.chat-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0;
  padding-left: 32rpx;
  position: relative;
  z-index: 10;
}
.chat-header .back-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 200, 220, 0.1);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 200, 220, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.chat-header .back-btn text {
  font-size: 40rpx;
  color: rgba(255, 220, 240, 0.7);
  font-weight: 300;
  pointer-events: none;
}
.chat-header .peer-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
