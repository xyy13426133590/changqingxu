/* 九宫格图片区 */
.moment-media-grid {
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
}
.moment-media-grid.grid-1 {
  display: block;
}
.moment-media-grid.grid-1 .grid-item {
  width: 100%;
  aspect-ratio: 4/3;
}
.moment-media-grid.grid-2, .moment-media-grid.grid-4 {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
}
.moment-media-grid.grid-2 .grid-item, .moment-media-grid.grid-4 .grid-item {
  width: calc(50% - 2rpx);
  aspect-ratio: 1;
}
.moment-media-grid.grid-3, .moment-media-grid.grid-6, .moment-media-grid.grid-9 {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
}
.moment-media-grid.grid-3 .grid-item, .moment-media-grid.grid-6 .grid-item, .moment-media-grid.grid-9 .grid-item {
  width: calc(33.33% - 3rpx);
  aspect-ratio: 1;
}
.moment-media-grid.grid-5, .moment-media-grid.grid-7, .moment-media-grid.grid-8 {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
}
.moment-media-grid.grid-5 .grid-item, .moment-media-grid.grid-7 .grid-item, .moment-media-grid.grid-8 .grid-item {
  width: calc(33.33% - 3rpx);
  aspect-ratio: 1;
}
.moment-media-grid .grid-item {
  overflow: hidden;
  background: rgba(255, 255, 255, 0.05);
}
.moment-media-grid .grid-item image {
  width: 100%;
  height: 100%;
  display: block;
}
