# 长情许交友小程序 - 本地开发环境
# 与 changqinbgxu-backend 联调：先启动后端 npm run start:dev（默认端口 3000）

# API 基础地址（NestJS 全局前缀 /api）
VITE_API_BASE_URL=http://192.168.1.34:3000/api

# WebSocket（与后端 MessagesGateway namespace /chat 一致）
VITE_WS_BASE_URL=ws://192.168.1.34:3000/chat

# 上传文件访问域名（生产填 OSS 自定义域名；本地可留占位）
VITE_UPLOAD_DOMAIN=https://changqingxu.oss-cn-beijing.aliyuncs.com
