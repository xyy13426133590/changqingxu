# pnpm + uni-app：扁平 node_modules，避免 @dcloudio/vite-plugin-uni 等软链断裂、CLI 找不到 bin/uni.js
node-linker=hoisted

# 子依赖提升（与 hoisted 叠加时仍有助于 socket 栈被正确解析）
public-hoist-pattern[]=socket.io-client
public-hoist-pattern[]=socket.io-parser
public-hoist-pattern[]=engine.io-client
public-hoist-pattern[]=engine.io-parser
public-hoist-pattern[]=@socket.io/component-emitter
