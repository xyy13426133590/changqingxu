# ============================================
# 长情许交友小程序后端环境变量配置示例
# 复制为 .env 文件并填写真实值
# ============================================

# 服务器配置
NODE_ENV=development
PORT=3000
API_PREFIX=api
# 本地上传回退时用此拼接媒体链接；小程序真机调试请设为电脑局域网 IP（如 http://192.168.1.100:3000）
# PUBLIC_BASE_URL=http://127.0.0.1:3000

# 数据库配置 (MySQL)
# --- 本地 MySQL 调试（前期推荐）---
# 1) 本机安装并启动 MySQL 8+；2) 建库并导入结构，任选其一：
#    - 执行 docs/database.sql（含 CREATE DATABASE changqingxu）
#    - 或仅建空库后设 DB_SYNCHRONIZE=true，由 TypeORM 自动建表（开发用）
# 3) 复制本文件为 .env，填写 DB_PASSWORD；4) DB_SSL 保持 false
# 腾讯云 CDB：把 DB_HOST 改为控制台地址，外网常需 DB_SSL=true
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your-db-password
DB_DATABASE=changqingxu
DB_SYNCHRONIZE=true
# 已完整执行 docs/database.sql 时，可改为 false，减少 TypeORM 自动同步带来的表结构差异问题
DB_LOGGING=false
# 外网连接腾讯云 MySQL 时通常需 DB_SSL=true；仅内网访问可省略或 false
DB_SSL=false
# 可选：控制台下载 CA 证书内容（或 PEM 路径自行读入后写入多行需转义时可用 \n）
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Redis 若用腾讯云数据库 Redis，同样把 REDIS_HOST 改为控制台给出的地址，并放行安全组

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 阿里云 OSS 配置
OSS_REGION=oss-cn-beijing
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=changqingxu
OSS_DOMAIN=https://changqingxu.oss-cn-beijing.aliyuncs.com

# 微信小程序配置
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret

# VIP / 微信支付 APIv3（JSAPI）
# WECHAT_PAY_MODE — mock：不调微信，仅建单；live：调 JSAPI 下单（需完整商户配置）
WECHAT_PAY_MODE=mock
WECHAT_PAY_MCHID=
WECHAT_PAY_MERCHANT_SERIAL=
WECHAT_PAY_API_V3_KEY=
# 商户 API 证书私钥：二选一（PEM 内联可用换行写成 \n）
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PRIVATE_KEY_PEM=
# 须 HTTPS 公网可达，与「小程序后台-支付授权目录 / 回调」一致
WECHAT_PAY_NOTIFY_URL=https://你的域名/api/vip/payment/wechat-notify
# 微信平台证书公钥 PEM（验签回调，live 生产必填）
WECHAT_PAY_PLATFORM_CERT_PEM=
# 开发模拟支付：仅 NODE_ENV=development 且设为 1 时，POST /vip/orders/:id/mock-pay 生效
VIP_MOCK_PAY=

# 日志配置
LOG_LEVEL=debug
LOG_FORMAT=combined
