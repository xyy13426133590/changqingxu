# 云函数环境变量模板（复制到云开发控制台 → 云函数 → 环境变量）
# 切勿提交真实 Secret 到 Git

# ── Phase 0 基础 ──
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
WECHAT_APPID=wx________________
WECHAT_SECRET=________________
NODE_ENV=production

# ── Phase 6 VIP 支付 ──
WECHAT_PAY_MODE=mock
# live 模式需填写以下项
# WECHAT_PAY_MCHID=
# WECHAT_PAY_MERCHANT_SERIAL=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_PRIVATE_KEY_PEM=
# WECHAT_PAY_NOTIFY_URL=https://xxx.tcb.qcloud.la/wechatPayNotify
# WECHAT_PAY_PLATFORM_CERT_PEM=
VIP_MOCK_PAY=1

# ── Phase 7 腾讯云 SMS ──
SMS_DEMO_MODE=1
# 生产关闭 SMS_DEMO_MODE 并填写：
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# SMS_SDK_APP_ID=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_ID=
# SMS_REGION=ap-guangzhou

# ── Phase 7 FaceID 实名/人脸 ──
FACEID_DEMO_MODE=1
# 生产关闭 FACEID_DEMO_MODE 并填写：
# FACEID_MERCHANT_ID=
# FACEID_RULE_ID_REALNAME=
# FACEID_RULE_ID_LIVENESS=
# FACEID_REGION=
